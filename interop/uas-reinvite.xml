<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- Callee side for re-INVITE: answer like uas-answer.xml, then handle one
     in-dialog re-INVITE (new CSeq) with a 200 carrying the same SDP, then
     the usual ACK + caller BYE teardown. Bob must already be registered
     from this port. -->
<scenario name="pbx-callee-reinvite">
  <recv request="INVITE" timeout="15000">
  </recv>

  <pause milliseconds="100"/>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=sippbob4
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:bob@[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=sippbob4
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:bob@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: 88

      v=0
      o=bob 999 111 IN IP4 127.0.0.1
      s=sipp
      c=IN IP4 127.0.0.1
      m=audio 4000 RTP/AVP 0

    ]]>
  </send>

  <recv request="ACK" timeout="8000">
  </recv>

  <!-- In-dialog re-INVITE: new CSeq, answered with unchanged SDP. -->
  <recv request="INVITE" timeout="15000">
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:bob@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: 88

      v=0
      o=bob 999 112 IN IP4 127.0.0.1
      s=sipp
      c=IN IP4 127.0.0.1
      m=audio 4000 RTP/AVP 0

    ]]>
  </send>

  <recv request="ACK" timeout="8000">
  </recv>

  <recv request="BYE" timeout="15000">
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="500"/>

  <!-- End of call. -->
</scenario>
